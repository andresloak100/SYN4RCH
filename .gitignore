# --- harvest and intermediate layers are not version controlled -----------
# data/raw/ is append-only machine output; data/interim/ is reproducible from
# it. Both can be large and neither is citable evidence on its own. The
# .gitkeep markers stay tracked so the layer structure survives a clone.
data/raw/*
!data/raw/.gitkeep
data/interim/*
!data/interim/.gitkeep

# Derived layers: regenerate, never cite (SCHEMA.md 4).
data/inferred/*
!data/inferred/.gitkeep
data/predictions/*
!data/predictions/.gitkeep

# data/curated/ and data/vocab/ ARE tracked in full: they are the dataset and
# its controlled vocabularies. Nothing below may exclude them.
!data/curated/
!data/curated/**
!data/vocab/
!data/vocab/**

# ...with one exception: a pre-migration copy of the dataset, kept by
# `syn4rch.curate.migrate` so that a schema migration is reversible on the
# machine that ran it (e.g. data/curated/records.0.1.0.jsonl.bak). It is a
# duplicate of a state that is already in the history, so committing it would
# only put two versions of the dataset in the tree at once.
data/curated/*.bak

# Generated reports. The markdown reports ARE tracked: they are the project's
# deliverables and the only durable record of a run, because data/raw/ and
# data/interim/ are not version controlled (see DECISIONS.md D-016). Anything
# else written here (dumps, figures, large tables) stays untracked.
reports/*
!reports/.gitkeep
!reports/*.md

# --- python ----------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.pytest_cache/
.coverage
htmlcov/

# --- os / editor -----------------------------------------------------------
.DS_Store
*.swp
.idea/
.vscode/
